# T14FinishService systemd timer: t14finish-version-check.timer
# Installed into ~/.config/systemd/user/. After edits run systemctl --user daemon-reload.
# Keep these as per-user units; do not require a system-wide root daemon.
[Unit]
Description=T14FinishService weekly version-check scheduler

[Timer]
# Wake daily so a low-battery day does not postpone the check for a whole week.
# The checker itself enforces a strict 604800-second minimum between web requests.
OnBootSec=10min
OnUnitActiveSec=1d
AccuracySec=15min
Persistent=true

[Install]
WantedBy=timers.target
