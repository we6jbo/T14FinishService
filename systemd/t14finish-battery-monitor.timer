# T14FinishService systemd timer: t14finish-battery-monitor.timer
# Installed into ~/.config/systemd/user/. After edits run systemctl --user daemon-reload.
# Keep these as per-user units; do not require a system-wide root daemon.
[Unit]
Description=Sample T14 battery usage every 10 minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=10min
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
