# T14FinishService systemd service: t14finish-battery-monitor.service
# Installed into ~/.config/systemd/user/. After edits run systemctl --user daemon-reload.
# Keep these as per-user units; do not require a system-wide root daemon.
[Unit]
Description=T14FinishService low-overhead battery usage sampler

[Service]
Type=oneshot
ExecStart=%h/.local/bin/t14finish-battery-monitor sample baseline
