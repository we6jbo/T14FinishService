# T14FinishService systemd service: t14-finish-service.service
# Installed into ~/.config/systemd/user/. After edits run systemctl --user daemon-reload.
# Keep these as per-user units; do not require a system-wide root daemon.
[Unit]
Description=T14FinishService background Qt service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/we6jbo/Projects/T14FinishService/build/Desktop_Debug/T14FinishService
Restart=on-failure
RestartSec=5
Environment=WE6JBO_CONTEXT_FILE=/home/we6jbo/.local/state/we6jbo-context/context.json
Environment=T14FINISH_PROJECT_ROOT=/home/we6jbo/Projects/T14FinishService
WorkingDirectory=/home/we6jbo/Projects/T14FinishService

[Install]
WantedBy=default.target
