#!/usr/bin/env bash
set -euo pipefail

PROJECT="/home/we6jbo/Projects/T14FinishService"
STATE_DIR="/home/we6jbo/.T14FinishService_backup"
STATUS="$STATE_DIR/status.json"
REMOTE_URL="https://github.com/we6jbo/T14FinishService.git"
BRANCH="master"
MIN_SECONDS=2400
MIN_FREE_KIB=$((10 * 1024 * 1024))
MIN_BATTERY=55

mkdir -p "$STATE_DIR"

free_kib=$(df -Pk "$PROJECT" | awk 'NR==2 {print $4}')
if [[ -z "$free_kib" || "$free_kib" -lt "$MIN_FREE_KIB" ]]; then
    exit 0
fi

battery=""
for cap in /sys/class/power_supply/BAT*/capacity; do
    [[ -r "$cap" ]] || continue
    battery=$(tr -dc '0-9' < "$cap")
    [[ -n "$battery" ]] && break
done
if [[ -z "$battery" || "$battery" -lt "$MIN_BATTERY" ]]; then
    exit 0
fi

now_epoch=$(date +%s)
now_iso=$(date --iso-8601=seconds)
last_push_epoch=0
if [[ -f "$STATUS" ]]; then
    last_push_epoch=$(python3 - "$STATUS" <<'PY'
import json,sys
try:
    with open(sys.argv[1], encoding='utf-8') as f:
        print(int(json.load(f).get('last_push_epoch', 0)))
except Exception:
    print(0)
PY
)
fi

elapsed=$((now_epoch - last_push_epoch))
due=false
if (( last_push_epoch == 0 || elapsed >= MIN_SECONDS )); then
    due=true
fi

python3 - "$STATUS" "$now_iso" "$now_epoch" "$last_push_epoch" "$due" "$battery" "$free_kib" <<'PY'
import json,sys,os,tempfile
path, now_iso, now_epoch, last_push, due, battery, free_kib = sys.argv[1:]
data = {
    "current_time": now_iso,
    "current_epoch": int(now_epoch),
    "last_push_epoch": int(last_push),
    "push_due": due.lower() == "true",
    "battery_percent": int(battery),
    "free_kib": int(free_kib),
    "minimum_push_interval_seconds": 2400
}
os.makedirs(os.path.dirname(path), exist_ok=True)
fd,tmp=tempfile.mkstemp(prefix='.status.', suffix='.json', dir=os.path.dirname(path))
with os.fdopen(fd,'w',encoding='utf-8') as f:
    json.dump(data,f,indent=2)
    f.write('\n')
os.replace(tmp,path)
PY

[[ "$due" == true ]] || exit 0
cd "$PROJECT"

if [[ ! -d .git ]]; then
    git init -b "$BRANCH"
fi

if ! git remote get-url origin >/dev/null 2>&1; then
    git remote add origin "$REMOTE_URL"
fi

# Make a best-effort fetch so the first backup can inspect the remote branch.
git fetch origin "$BRANCH" --quiet 2>/dev/null || true

FIRST_MARKER="$STATE_DIR/first_github_backup_complete"
if [[ ! -e "$FIRST_MARKER" ]]; then
    remote_has_3751=false
    if git cat-file -e "origin/$BRANCH:3751.txt" 2>/dev/null; then
        remote_has_3751=true
    fi

    if [[ "$remote_has_3751" == false ]]; then
        if [[ ! -f "$PROJECT/3751.txt" ]]; then
            printf '%s\n' 'T14FinishService GitHub backup verification file 3751' > "$PROJECT/3751.txt"
        fi
    fi
fi

# Only stage files belonging to this project package. Existing Qt template files are included.
FILES=(
  CMakeLists.txt CMakeLists.template-original.txt
  main.cpp mainwindow.cpp mainwindow.h mainwindow.ui
  service_main.cpp finishservice.cpp finishservice.h
  tg_context_snapshot.json README.md 3751.txt
  scripts/t14-finish scripts/t14finish-git-backup
  systemd/t14-finish-service.service systemd/t14finish-git-backup.service systemd/t14finish-git-backup.timer
  install.sh
)
for f in "${FILES[@]}"; do
    [[ -e "$f" ]] && git add -- "$f"
done

if ! git diff --cached --quiet; then
    git commit -m "Automatic T14FinishService backup $(date '+%Y-%m-%d %H:%M:%S %Z')"
fi

# Push even when there was no new commit on the first run, so 3751.txt is verified remotely.
git push -u origin "$BRANCH"

touch "$FIRST_MARKER"
new_push_epoch=$(date +%s)
new_push_iso=$(date --iso-8601=seconds)
python3 - "$STATUS" "$new_push_iso" "$new_push_epoch" <<'PY'
import json,sys,os,tempfile
path, iso, epoch = sys.argv[1:]
try:
    with open(path, encoding='utf-8') as f:
        data=json.load(f)
except Exception:
    data={}
data['current_time']=iso
data['current_epoch']=int(epoch)
data['last_push_time']=iso
data['last_push_epoch']=int(epoch)
data['push_due']=False
fd,tmp=tempfile.mkstemp(prefix='.status.', suffix='.json', dir=os.path.dirname(path))
with os.fdopen(fd,'w',encoding='utf-8') as f:
    json.dump(data,f,indent=2)
    f.write('\n')
os.replace(tmp,path)
PY
